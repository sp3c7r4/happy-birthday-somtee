# Copy this file to .env.local and fill in your connection string.
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name to store wishes in
MONGODB_DB=somto_birthday
# Optional: override DNS servers if your network breaks mongodb+srv discovery
# DNS_SERVERS=8.8.8.8,1.1.1.1
